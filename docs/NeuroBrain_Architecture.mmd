flowchart LR
    U[User]
    UI[CLI or local web interface]
    P[Privacy and input policy]
    G[Google Drive folder\nplanned cloud source]
    L[Local TXT/Markdown files\nimplemented source]
    I[Import and chunk service]
    S[(SQLite + FTS5\nimplemented baseline)]
    DB[(Supabase PostgreSQL\nplanned cloud store)]
    Q[Question]
    R[Lexical retrieval\nimplemented]
    H[Hybrid/vector retrieval\nplanned]
    E[Exact cited excerpts]
    F[Forget selected source]
    X[Deletion verification]
    M[Admission model\nplanned suggestion mode]
    A[Cited answer or abstention\nplanned generation]

    U --> UI
    UI --> L
    UI --> G
    L --> P
    G --> P
    P --> I
    I --> S
    I -. future cloud write .-> DB

    Q --> R
    R --> S
    S --> E
    Q -. future semantic search .-> H
    H -.-> DB
    H -.-> A

    F --> X
    X --> S
    X -. future cloud purge .-> DB

    I -. optional future scoring .-> M
    M -. gated admission .-> S

    classDef implemented fill:#d9f7e8,stroke:#16824b,color:#123b26;
    classDef planned fill:#fff0c2,stroke:#b7791f,color:#5b3a00,stroke-dasharray: 5 5;
    classDef neutral fill:#eef2f7,stroke:#64748b,color:#1e293b;

    class UI,P,L,I,S,R,E,F,X implemented;
    class G,DB,H,M,A planned;
    class U,Q neutral;
