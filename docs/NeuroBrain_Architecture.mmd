%% NeuroBrain planned cloud architecture
flowchart LR
    U[User]
    UI[Web or CLI interface]
    AUTH[Supabase Auth]
    G[Google Drive\nselected notes folder]
    P[Privacy and input policy]
    I[Import and chunk service]
    M[Memory-admission model\nsuggestion or gated admission]
    DB[(Supabase PostgreSQL\nversions, chunks, provenance)]
    V[(pgvector\nembeddings)]
    Q[User question]
    R[Hybrid retrieval\nkeyword + semantic + time filters]
    L[Local language model]
    A[Cited answer or abstention]
    F[Forget request]
    X[Deletion service\npurge and verify]
    T[Training and evaluation data\nfictional and versioned]
    C[Versioned model checkpoint]

    U --> UI
    UI --> AUTH
    AUTH --> UI

    G --> P
    UI --> P
    P --> I
    I --> M
    M --> DB
    I --> V
    DB --> V

    Q --> R
    R --> DB
    R --> V
    R --> L
    L --> A
    R --> A

    F --> X
    X --> DB
    X --> V
    X --> G

    T --> C
    C --> M

    classDef service fill:#dbeafe,stroke:#2563eb,color:#172554;
    classDef storage fill:#dcfce7,stroke:#16a34a,color:#14532d;
    classDef security fill:#fef3c7,stroke:#d97706,color:#78350f;
    classDef model fill:#f3e8ff,stroke:#9333ea,color:#581c87;
    classDef user fill:#f1f5f9,stroke:#64748b,color:#1e293b;

    class UI,P,I,R,X service;
    class G,DB,V storage;
    class AUTH security;
    class M,L,T,C model;
    class U,Q,A user;
